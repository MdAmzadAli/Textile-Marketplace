# Postgres connection string. Must point to a database with the pgvector extension
# available (Supabase and Neon support this out of the box; local Postgres needs
# `CREATE EXTENSION vector;` run once, see README for the exact command).
DATABASE_URL=""
# Any random long strings — used to sign JWTs. Keep access/refresh different.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Optional, defaults shown
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Used later by the AI assistant module (not wired yet)
GEMINI_API_KEY=
HF_API_KEY=
